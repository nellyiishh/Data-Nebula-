# Copy to backend/.env and adjust. Every value here is optional.

# Folder the API reads prepared sites from (default: <repo>/data/derived).
NEBULA_DATA_DIR=../data/derived

# Origins allowed to call the API from a browser, as a JSON list.
NEBULA_CORS_ORIGINS=["http://localhost:5173"]

# NASA Earthdata Login, only for the offline pipeline (prepare_nisar), never for the API.
# Prefer a token (https://urs.earthdata.nasa.gov → Generate Token) over the password.
EARTHDATA_TOKEN=
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
