          }
        },
        "required": [
          "threshold_db",
          "pair",
          "changed_inside_pct",
          "changed_outside_pct",
          "method"
        ],
        "title": "Validation",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Read-only API over NISAR radar layers prepared offline by the pipeline.",
    "title": "Data Nebula API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/health": {
      "get": {
        "description": "Returns ok when the API process is up. Used by the hosting platform.",
        "operationId": "health_api_v1_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthStatus"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Liveness check",
        "tags": [
          "health"
        ]
      }
    },
    "/api/v1/sites": {
      "get": {
        "description": "Every study area the pipeline has prepared. Empty until a site is built.",
        "operationId": "list_sites_api_v1_sites_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/SiteSummary"
                  },
                  "title": "Response List Sites Api V1 Sites Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List prepared sites",
        "tags": [
          "sites"
        ]
      }
    },
    "/api/v1/sites/{site_id}": {
      "get": {
        "description": "Corners, dates, layers, provenance and points of interest for one site.",
        "operationId": "get_site_api_v1_sites__site_id__get",
        "parameters": [
          {
            "description": "Site ID, e.g. demo-reservoir",
            "in": "path",
            "name": "site_id",
            "required": true,
            "schema": {
              "description": "Site ID, e.g. demo-reservoir",
              "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
              "title": "Site Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SiteDetail"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unknown site, date or layer."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Invalid parameters."
          }
        },
        "summary": "Get one site",
        "tags": [
          "sites"
        ]
      }
    },
    "/api/v1/sites/{site_id}/change.png": {
      "get": {
        "description": "Red: surface got darker to radar (e.g. new water, harvest). Blue: got brighter (e.g. water retreat, crop growth). Unchanged pixels are transparent.",
        "operationId": "get_change_api_v1_sites__site_id__change_png_get",
        "parameters": [
          {
            "description": "Site ID, e.g. demo-reservoir",
            "in": "path",
            "name": "site_id",
            "required": true,
            "schema": {
              "description": "Site ID, e.g. demo-reservoir",
              "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
              "title": "Site Id",
              "type": "string"
            }
          },
          {
            "description": "Earlier date",
            "in": "query",
            "name": "from",
            "required": true,
            "schema": {
              "description": "Earlier date",
              "format": "date",
              "title": "From",
              "type": "string"
            }
          },
          {
            "description": "Later date",
            "in": "query",
            "name": "to",
            "required": true,
            "schema": {
              "description": "Later date",
              "format": "date",
              "title": "To",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "polarization",
            "required": false,
            "schema": {
              "default": "hh",
              "enum": [
                "hh",
                "hv"
              ],
              "title": "Polarization",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "image/png": {}
            },
            "description": "Transparent PNG over the site corners."
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unknown site, date or layer."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Invalid parameters."
          }
        },
        "summary": "Change between two dates",
        "tags": [
          "sites"
        ]
      }
    },
    "/api/v1/sites/{site_id}/files/{file_path}": {
      "get": {
        "description": "Files the slope_echo block points at (ext/\u2026), plus layer images (layers/\u2026). Paths are the same as in the static export, relative to the site folder.",
        "operationId": "get_site_file_api_v1_sites__site_id__files__file_path__get",
        "parameters": [
          {
            "description": "Site ID, e.g. demo-reservoir",
            "in": "path",
            "name": "site_id",
            "required": true,
            "schema": {
              "description": "Site ID, e.g. demo-reservoir",
              "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
              "title": "Site Id",
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "file_path",
            "required": true,
            "schema": {
              "title": "File Path",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unknown site, date or layer."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Invalid parameters."
          }
        },
        "summary": "A file of the site's story",
        "tags": [
          "sites"
        ]
      }
    },
    "/api/v1/sites/{site_id}/layers/{layer}/{date}.png": {
      "get": {
        "description": "hh/hv: grayscale backscatter \u00b7 rgb: HH/HV/ratio colour mix \u00b7 water: water mask.",
        "operationId": "get_layer_api_v1_sites__site_id__layers__layer___date__png_get",
        "parameters": [
          {
            "description": "Site ID, e.g. demo-reservoir",
            "in": "path",
            "name": "site_id",
            "required": true,
            "schema": {
              "description": "Site ID, e.g. demo-reservoir",
              "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
              "title": "Site Id",
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "layer",
            "required": true,
            "schema": {
              "enum": [
                "hh",
                "hv",
                "rgb",
                "water"
              ],
              "title": "Layer",
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "date",
            "required": true,
            "schema": {
              "format": "date",
              "title": "Date",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "image/png": {}
            },
            "description": "Transparent PNG over the site corners."
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unknown site, date or layer."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Invalid parameters."
          }
        },
        "summary": "Layer image for one date",
        "tags": [
          "sites"
        ]
      }
    },
    "/api/v1/sites/{site_id}/stats": {
      "get": {
        "description": "Open-water area and mean backscatter for each acquisition date.",
        "operationId": "get_stats_api_v1_sites__site_id__stats_get",
        "parameters": [
          {
            "description": "Site ID, e.g. demo-reservoir",
            "in": "path",
            "name": "site_id",
            "required": true,
            "schema": {
              "description": "Site ID, e.g. demo-reservoir",
              "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
              "title": "Site Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SiteStats"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unknown site, date or layer."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Invalid parameters."
          }
        },
        "summary": "Site statistics per date",
        "tags": [
          "sites"
        ]
      }
    },
    "/api/v1/sites/{site_id}/timeseries": {
      "get": {
        "description": "HH and HV in dB at a clicked point (3x3 pixel average) for every date.",
        "operationId": "get_timeseries_api_v1_sites__site_id__timeseries_get",
        "parameters": [
          {
            "description": "Site ID, e.g. demo-reservoir",
            "in": "path",
            "name": "site_id",
            "required": true,
            "schema": {
              "description": "Site ID, e.g. demo-reservoir",
              "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
              "title": "Site Id",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "lon",
            "required": true,
            "schema": {
              "maximum": 180,
              "minimum": -180,
              "title": "Lon",
              "type": "number"
            }
          },
          {
            "in": "query",
            "name": "lat",
            "required": true,
            "schema": {
              "maximum": 85,
              "minimum": -85,
              "title": "Lat",
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PointTimeseries"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unknown site, date or layer."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Invalid parameters."
          }
        },
        "summary": "Backscatter over time at a point",
        "tags": [
          "sites"
        ]
      }
    }
  }
}
